---
import type { PostListProps } from '@/types'
import PreviewCard from '@/components/widgets/PreviewCard.astro'

const { posts } = Astro.props as PostListProps
---

<section class="section">
  <h2>Projects</h2>
  <ul>
    {
      posts.map((post) => (
        <li>
          <PreviewCard href={`/${post.id}/`} title={post.data.title} image={post.data.image} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    margin: 2.25rem 0 0;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
  }

  ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem 1rem;
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    ul:hover :global(.preview-card) {
      opacity: 0.4;
    }

    ul:hover :global(.preview-card:hover) {
      opacity: 1;
    }
  }
</style>
