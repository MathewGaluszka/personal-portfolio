---
import { portfolio } from '@/data/portfolio'
import About from '@/components/widgets/About.astro'
---

<section class="intro">
  <h1>{portfolio.name}</h1>
  <p class="headline">{portfolio.headline}</p>
  <p class="school">{portfolio.school.name} · {portfolio.school.year} · {portfolio.school.gpa}</p>
  <p class="links">
    <a href={portfolio.resumePath} target="_blank" rel="noreferrer">Resume</a>
    <a
      class="email-link"
      href={`mailto:${portfolio.email}`}
      data-email={portfolio.email}
      target="_blank"
      rel="noopener noreferrer"
    >
      Email
    </a>
    <a href={portfolio.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    <a href={portfolio.github} target="_blank" rel="noreferrer">Github</a>
  </p>
  <About />
</section>

<style>
  .intro {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .headline {
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .school {
    margin: 0.15rem 0 0.75rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .links a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--text-secondary);
  }

  .intro :global(.about) {
    margin: 1.15rem 0 0;
  }

  .intro :global(.about p) {
    margin: 0 0 0.75rem;
    line-height: 1.6;
    color: var(--text-primary);
  }

  .intro :global(.about p:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  async function copyEmail(email: string) {
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(email)
        return
      }
    } catch {
      // Fall through to execCommand if the clipboard API is blocked.
    }

    const input = document.createElement('textarea')
    input.value = email
    input.setAttribute('readonly', '')
    input.style.position = 'fixed'
    input.style.left = '-9999px'
    document.body.appendChild(input)
    input.select()
    const copied = document.execCommand('copy')
    input.remove()
    if (!copied) throw new Error('Copy failed')
  }

  function bindEmailLink() {
    const link = document.querySelector<HTMLAnchorElement>('.email-link')
    if (!link || link.dataset.bound === 'true') return
    link.dataset.bound = 'true'

    link.addEventListener('click', async (event) => {
      event.preventDefault()
      const email = link.dataset.email
      if (!email) return

      const original = link.textContent
      try {
        await copyEmail(email)
        link.textContent = 'Copied'
      } catch {
        link.textContent = email
      }

      window.setTimeout(() => {
        link.textContent = original
      }, 1600)
    })
  }

  bindEmailLink()
  document.addEventListener('astro:page-load', bindEmailLink)
</script>
