---
import { portfolio } from '@/data/portfolio'
---

<section class="section skills">
  <h2>Skills</h2>
  <div class="pillars">
    {
      [
        ['Electrical', portfolio.skills.electrical],
        ['Software', portfolio.skills.software],
        ['Mechanical', portfolio.skills.mechanical]
      ].map(([title, groups]) => (
        <div>
          <h3>{title}</h3>
          {groups.map((group) => (
            <p>
              <span class="label">{group.label}:</span> {group.items}
            </p>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .section {
    margin: 2.25rem 0 0;
  }

  h2,
  h3 {
    margin: 0;
    font-weight: var(--font-weight-bold);
  }

  h2 {
    margin-bottom: 0.5rem;
    font-size: var(--font-size-l);
  }

  h3 {
    margin: 0.85rem 0 0.2rem;
    font-size: var(--font-size-m);
  }

  p {
    margin: 0;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .pillars p {
    margin-top: 0.35rem;
    color: var(--text-primary);
  }

  .label {
    font-weight: var(--font-weight-bold);
  }
</style>
