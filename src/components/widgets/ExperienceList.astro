---
import type { ExperienceListProps } from '@/types'
import PreviewCard from '@/components/widgets/PreviewCard.astro'

const { jobs } = Astro.props as ExperienceListProps
---

<section class="section work">
  <h2>Work Experience</h2>
  <ul>
    {
      jobs.map((job) => (
        <li>
          <PreviewCard
            href={`/work/${job.id}/`}
            title={job.data.title}
            subtitle={job.data.company}
            detail={job.data.dates}
            image={job.data.image}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .section {
    margin: 2.25rem 0 0;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
  }

  ul {
    padding: 0;
    margin: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.35rem 1rem;
  }

  @media (max-width: 40rem) {
    ul {
      grid-template-columns: 1fr;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    ul:hover :global(.preview-card) {
      opacity: 0.4;
    }

    ul:hover :global(.preview-card:hover) {
      opacity: 1;
    }
  }
</style>
