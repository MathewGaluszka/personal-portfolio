---
import { portfolio } from '@/data/portfolio'
---

<section class="section">
  <h2>School</h2>
  <p class="name">{portfolio.school.name}</p>
  <p>{portfolio.school.year} · {portfolio.school.gpa}</p>
</section>

<style>
  .section {
    margin: 2.25rem 0 0;
  }

  h2 {
    margin: 0 0 0.5rem;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  .name {
    font-weight: var(--font-weight-bold);
  }
</style>
