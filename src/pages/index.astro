---
import IndexLayout from '@/layouts/IndexLayout.astro'
import Intro from '@/components/widgets/Intro.astro'
import Skills from '@/components/widgets/Skills.astro'
import PostList from '@/components/widgets/PostList.astro'
import ExperienceList from '@/components/widgets/ExperienceList.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts, getSortedFilteredWork } from '@/utils/draft'

const posts = await getSortedFilteredPosts()
const jobs = await getSortedFilteredWork()
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <Intro />
  <PostList posts={posts} />
  <ExperienceList jobs={jobs} />
  <Skills />
</IndexLayout>
